; Import definitions for the system SQLite (System32\winsqlite3.dll, Windows 10+).
; Only the functions src/db/sqlite_c.zig declares.
LIBRARY winsqlite3.dll
EXPORTS
    sqlite3_bind_double
    sqlite3_bind_int
    sqlite3_bind_int64
    sqlite3_bind_null
    sqlite3_bind_text
    sqlite3_changes
    sqlite3_clear_bindings
    sqlite3_close
    sqlite3_column_blob
    sqlite3_column_bytes
    sqlite3_column_count
    sqlite3_column_double
    sqlite3_column_int64
    sqlite3_column_text
    sqlite3_column_type
    sqlite3_errmsg
    sqlite3_exec
    sqlite3_finalize
    sqlite3_free
    sqlite3_last_insert_rowid
    sqlite3_open
    sqlite3_prepare_v2
    sqlite3_reset
    sqlite3_step
